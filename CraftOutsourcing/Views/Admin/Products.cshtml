@{
    ViewData["Title"] = "Danh Mục Sản Phẩm (BOM)";
    Layout = "_AdminLayout";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
    <div>
        <h2 style="margin: 0 0 8px 0; font-size: 32px; font-weight: 800; color: #1F2937;">⚙️ Danh Mục Sản Phẩm & Định Mức</h2>
        <p style="margin: 0; color: #6B7280; font-size: 15px;">Quản lý sản phẩm và định mức vật tư (BOM)</p>
    </div>
    <button class="btn btn-primary" onclick="openAddModal()" style="padding: 10px 20px; font-size: 15px; background: linear-gradient(135deg, #10B981 0%, #059669 100%); box-shadow: 0 4px 15px rgba(16,185,129,0.3);">+ Thêm Sản Phẩm</button>
</div>

<div class="card p-4">
    <p class="text-muted mb-3">Tạo danh sách các Sản Phẩm (VD: Rổ, Thúng) mà Cơ sở sẽ lấy lại từ Hộ dân.<br/>Hệ thống bắt buộc phải **Khai báo Định Mức (BOM)** để biết làm 1 cái Rổ tốn bao nhiêu kg Mây, từ đó tự trừ Mây trong kho khi bạn ấn <a href="/Admin/Assignments">Giao Việc</a>.</p>
    
    <table class="table w-100" id="productsTable">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên Sản Phẩm</th>
                <th>Tiền Công / Cái</th>
                <th>Định Mức Vật Tư (BOM)</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<div id="addModal" class="modal-overlay" style="display: none;">
    <div class="modal-content" style="max-width: 600px;">
        <h3>Thêm Sản Phẩm Mới</h3>
        
        <div class="form-group mt-3">
            <label>Tên Sản Phẩm <span class="required">*</span> (VD: Rổ Mây Đan Chéo)</label>
            <input type="text" id="txtName" class="form-control" required
                   data-validate="nameOnly"
                   data-field-name="Tên sản phẩm"
                   placeholder="Ví dụ: Rổ, Thúng, Giỏ, v.v." />
        </div>
        
        <div class="form-group">
            <label>Tiền Công Trả Thợ (VNĐ / Cái)</label>
            <input type="number" id="txtPrice" class="form-control" placeholder="Nhập giá sản phẩm (VND)" />
        </div>

        <div class="form-group mt-4">
            <label style="color:var(--primary); font-weight:700;">Định mức Vật Tư (Làm 1 sản phẩm tốn bao nhiêu vật liệu?)</label>
            <div id="materialsList" class="mt-2"></div>
            <button class="btn btn-secondary btn-sm mt-2" onclick="addMaterialRow()">+ Thêm Vật Tư Tiêu Hao</button>
        </div>

        <div class="modal-actions mt-4">
            <button class="btn btn-secondary" onclick="closeAddModal()">Hủy</button>
            <button class="btn btn-primary" onclick="saveProduct()">Lưu Danh Mục</button>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .table { width: 100%; border-collapse: collapse; }
        .table th, .table td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--border-color); }
        .table th { background: #F3F4F6; font-weight: 600; }
        .mb-3 { margin-bottom: 16px; }
        .mt-2 { margin-top: 8px; }
        .mt-3 { margin-top: 16px; }
        .mt-4 { margin-top: 24px; }
        
        .modal-overlay {
            position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5);
            display: flex; align-items: center; justify-content: center;
            z-index: 1000;
        }
        .modal-content { background: white; padding: 24px; border-radius: 12px; width: 100%; }
        .modal-actions { display: flex; justify-content: flex-end; gap: 10px; }
        .material-row { display: flex; gap: 10px; margin-bottom: 10px; }
        .badge { background: #E0E7FF; color: #4338CA; padding: 4px 8px; border-radius: 4px; font-size: 13px; margin-right: 4px; display: inline-block; margin-bottom: 4px; border: 1px solid #C7D2FE;}
    </style>
}

@section Scripts {
    <script>
        let allMaterials = [];

        document.addEventListener('DOMContentLoaded', async () => {
            await loadProducts();
            
            // Load list vật tư cho thẻ Select Modal
            const res = await fetch('/Admin/GetMaterials');
            allMaterials = await res.json();
        });

        async function loadProducts() {
            try {
                const res = await fetch('/Admin/GetProducts');
                const data = await res.json();
                const tbody = document.querySelector('#productsTable tbody');
                tbody.innerHTML = '';
                
                if(data.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="4" style="text-align:center; padding:30px;">Danh mục Sản phẩm đang trống. Vui lòng bấm "Thêm Sản Phẩm".</td></tr>`;
                    return;
                }

                data.forEach(p => {
                    let bomHtml = p.materials.map(m => `<span class="badge"><i class="fa fa-cube"></i> ${m.name} (${m.quantityRequired} ${m.unit})</span>`).join('');
                    if (!bomHtml) bomHtml = '<em class="text-muted">Không có</em>';

                    tbody.innerHTML += `
                        <tr>
                            <td>#${p.id}</td>
                            <td><strong style="color:var(--primary); font-size:16px;">${p.name}</strong></td>
                            <td style="color:#059669; font-weight:600;">${p.unitPrice.toLocaleString('vi-VN')} đ</td>
                            <td>${bomHtml}</td>
                        </tr>
                    `;
                });
            } catch (error) {
                console.error("Lỗi:", error);
            }
        }

        function openAddModal() {
            document.getElementById('txtName').value = '';
            document.getElementById('txtPrice').value = '';
            document.getElementById('materialsList').innerHTML = '';
            
            if(allMaterials.length === 0) {
                showWarning('⚠️ Vui lòng vào tab "Vật Tư" thêm nguyên liệu trước!');
                return;
            }

            addMaterialRow(); 
            document.getElementById('addModal').style.display = 'flex';
        }

        function closeAddModal() { document.getElementById('addModal').style.display = 'none'; }

        function addMaterialRow() {
            const row = document.createElement('div');
            row.className = 'material-row';
            
            let options = allMaterials.map(m => `<option value="${m.id}">${m.name} (${m.unit})</option>`).join('');
            
            row.innerHTML = `
                <select class="form-control sel-mat" style="flex:2">
                    ${options}
                </select>
                <input type="number" class="form-control txt-qty" placeholder="Số lượng tiêu hao" min="0.01" step="any" style="flex:1" />
                <button class="btn btn-secondary btn-sm" onclick="this.parentElement.remove()"><i class="fa fa-trash"></i></button>
            `;
            document.getElementById('materialsList').appendChild(row);
        }

        async function saveProduct() {
            const nameInput = document.getElementById('txtName');
            const priceInput = document.getElementById('txtPrice');
            
            // Validate name
            if (!validateRequired(nameInput, 'Tên sản phẩm')) return;
            if (!validateInput(nameInput, 'nameOnly')) return;
            
            const name = nameInput.value.trim();
            const price = parseFloat(priceInput.value);
            
            const matRows = document.querySelectorAll('.material-row');
            const materials = [];
            
            matRows.forEach(row => {
                const matId = parseInt(row.querySelector('.sel-mat').value);
                const qty = parseFloat(row.querySelector('.txt-qty').value);
                if(matId && qty > 0) {
                    materials.push({ materialId: matId, quantityRequired: qty });
                }
            });

            if(materials.length === 0) {
                showError('⚠️ Vui lòng chỉ định tối thiểu một vật tư hợp lệ');
                return;
            }

            try {
                const payload = {
                    name: name,
                    unitPrice: isNaN(price) ? 0 : price,
                    materials: materials
                };

                const res = await fetch('/Admin/AddProduct', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                
                if(!res.ok) {
                    const err = await res.text();
                    showError('✕ Lỗi khi thêm: ' + err);
                    return;
                }

                showSuccess('✓ Tạo sản phẩm & BOM thành công');
                closeAddModal();
                loadProducts();
            } catch(e) {
                showError('✕ Lỗi máy chủ: ' + e.message);
            }
        }
    </script>
}
