@{
    ViewData["Title"] = "Quản Lý Kho Vật Tư";
    Layout = "_AdminLayout";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
    <div>
        <h2 style="margin: 0 0 8px 0; font-size: 32px; font-weight: 800; color: #1F2937;">📦 Kho Vật Tư</h2>
        <p style="margin: 0; color: #6B7280; font-size: 15px;">Quản lý nguyên liệu và vật tư</p>
    </div>
    <button class="btn btn-primary" onclick="openAddModal()" style="padding: 10px 20px; font-size: 15px; background: linear-gradient(135deg, #06B6D4 0%, #0891B2 100%); box-shadow: 0 4px 15px rgba(6,182,212,0.3);">+ Thêm Mới Vật Tư</button>
</div>

<div class="card p-4">
    <table class="table w-100" id="materialsTable">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên Vật Tư</th>
                <th>Đơn Vị Tính</th>
                <th>Tồn Kho</th>
                <th>Hành Động</th>
            </tr>
        </thead>
        <tbody>
            <!-- Dữ liệu render từ AJAX -->
        </tbody>
    </table>
</div>

<!-- Modal Thêm Vật Tư -->
<div id="addModal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
        <h3>Thêm Vật Tư Mới</h3>
        <div class="form-group mt-4">
            <label>Tên Vật Tư <span class="required">*</span></label>
            <input type="text" id="matName" class="form-control" required 
                   data-validate="nameOnly" 
                   data-field-name="Tên vật tư"
                   placeholder="Ví dụ: Vải cotton, Sơn acrylic" />
        </div>
        <div class="form-group">
            <label>Đơn Vị Tính</label>
            <select id="matUnit" class="form-control">
                <option value="">-- Chọn đơn vị tính --</option>
                @if (ViewBag.Units != null)
                {
                    @foreach (var unit in ViewBag.Units)
                    {
                        <option value="@unit">@unit</option>
                    }
                }
            </select>
        </div>
        <div class="form-group">
            <label>Giá Đơn Vị (VND)</label>
            <input type="number" id="matPrice" class="form-control" min="0" step="1000" placeholder="Nhập giá (VD: 50000)" />
        </div>
        <div class="form-group">
            <label>Mức Tồn Tối Thiểu</label>
            <input type="number" id="matMinStock" class="form-control" min="0" step="0.1" placeholder="Nhập mức tồn (VD: 100)" />
        </div>
        <div class="modal-actions mt-4">
            <button class="btn btn-secondary" onclick="closeModal()">Hủy</button>
            <button class="btn btn-primary" onclick="saveMaterial()">Lưu Lại</button>
        </div>
    </div>
</div>

<!-- Modal Nhập Kho -->
<div id="importModal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
        <h3>Nhập Kho Vật Tư</h3>
        <p>Vật tư: <strong id="importMatName"></strong></p>
        <input type="hidden" id="importMatId" />
        
        <div class="form-group mt-4">
            <label>Số Lượng Nhập</label>
            <input type="number" id="importQuantity" class="form-control" min="0.1" step="0.1" />
        </div>
        <div class="modal-actions mt-4">
            <button class="btn btn-secondary" onclick="closeImportModal()">Hủy</button>
            <button class="btn btn-success" onclick="saveImport()">Xác Nhận Nhập</button>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .table { width: 100%; border-collapse: collapse; }
        .table th, .table td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--border-color); }
        .table th { background: #F3F4F6; font-weight: 600; }
        .btn-sm { padding: 6px 12px; font-size: 13px; margin-right: 5px; }
        .btn-success { background: var(--success); color: white; }
        .btn-danger { background: #EF4444; color: white; }
        
        .modal-overlay {
            position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5);
            display: flex; align-items: center; justify-content: center;
            z-index: 1000;
        }
        .modal-content {
            background: white; padding: 24px; border-radius: 12px;
            width: 100%; max-width: 400px;
        }
        .modal-actions { display: flex; justify-content: flex-end; gap: 10px; }
        .btn-secondary { background: #E5E7EB; color: #374151; }
    </style>
}

@section Scripts {
    <script>
        // Load danh sách vật tư khi mở trang
        document.addEventListener('DOMContentLoaded', loadMaterials);

        async function loadMaterials() {
            try {
                const res = await fetch('/Admin/GetMaterials');
                const data = await res.json();
                
                const tbody = document.querySelector('#materialsTable tbody');
                tbody.innerHTML = '';
                
                data.forEach(m => {
                    tbody.innerHTML += `
                        <tr>
                            <td>${m.id}</td>
                            <td><strong>${m.name}</strong></td>
                            <td>${m.unit}</td>
                            <td>
                                <span class="badge ${m.stockQuantity <= 0 ? 'bg-danger' : 'bg-success'}">
                                    ${m.stockQuantity}
                                </span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-success" onclick="openImportModal(${m.id}, '${m.name}')">Nhập Kho</button>
                                <button class="btn btn-sm btn-danger" onclick="deleteMaterial(${m.id}, '${m.name}')">Xóa</button>
                            </td>
                        </tr>
                    `;
                });
            } catch (error) {
                console.error("Lỗi:", error);
            }
        }

        // Add Modal
        function openAddModal() { document.getElementById('addModal').style.display = 'flex'; }
        function closeModal() { document.getElementById('addModal').style.display = 'none'; }
        
        async function saveMaterial() {
            const nameInput = document.getElementById('matName');
            const unitInput = document.getElementById('matUnit');
            const priceInput = document.getElementById('matPrice');
            const minStockInput = document.getElementById('matMinStock');
            
            // Validate required fields
            if (!validateRequired(nameInput, 'Tên vật tư')) return;
            if (!unitInput.value) {
                showError('⚠️ Vui lòng chọn đơn vị tính');
                return;
            }
            
            // Validate name format
            if (!validateInput(nameInput, 'nameOnly')) return;
            
            const name = nameInput.value.trim();
            const unit = unitInput.value;
            const price = parseFloat(priceInput.value) || 0;
            const minStock = parseFloat(minStockInput.value) || 0;

            try {
                const res = await fetch('/Admin/AddMaterial', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        Name: name, 
                        Unit: unit,
                        UnitPrice: price,
                        MinStock: minStock
                    })
                });

                if(res.ok) {
                    nameInput.value = '';
                    unitInput.value = '';
                    priceInput.value = '0';
                    minStockInput.value = '0';
                    closeModal();
                    showSuccess('✓ Thêm vật tư thành công');
                    loadMaterials();
                } else {
                    const error = await res.text();
                    showError('✕ Lỗi khi thêm vật tư: ' + error);
                }
            } catch (error) {
                console.error("Lỗi:", error);
                showError('✕ Lỗi: ' + error.message);
            }
        }

        // Import Modal
        function openImportModal(id, name) {
            document.getElementById('importMatId').value = id;
            document.getElementById('importMatName').innerText = name;
            document.getElementById('importQuantity').value = '';
            document.getElementById('importModal').style.display = 'flex';
        }
        function closeImportModal() { document.getElementById('importModal').style.display = 'none'; }
        
        async function saveImport() {
            const id = document.getElementById('importMatId').value;
            const qty = document.getElementById('importQuantity').value;
            
            if(!qty || qty <= 0) {
                showError('✕ Số lượng nhập không hợp lệ');
                return;
            }

            await fetch(`/Admin/ImportMaterial/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(qty) // Sending as raw JSON number based on [FromBody] double
            });

            closeImportModal();
            showSuccess('✓ Nhập kho thành công');
            loadMaterials();
        }

        // Delete Material
        async function deleteMaterial(id, name) {
            confirmDialog(
                `Bạn chắc chắn muốn xóa vật tư <strong>"${name}"</strong>?\n\nHành động này không thể hoàn tác.`,
                'Xóa Vật Tư',
                async () => {
                    try {
                        const res = await fetch(`/Admin/DeleteMaterial/${id}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' }
                        });

                        const result = await res.json();
                        
                        if(res.ok) {
                            showSuccess('✓ Xóa vật tư thành công');
                            loadMaterials();
                        } else {
                            showError('✕ Lỗi: ' + (result.error || result));
                        }
                    } catch (error) {
                        console.error("Lỗi:", error);
                        showError('✕ Lỗi khi xóa vật tư: ' + error.message);
                    }
                }
            );
        }
    </script>
}
